{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js vite.config.ts eslint.config.mjs",
        "lint:fix": "eslint resources/js vite.config.ts eslint.config.mjs --fix",
        "format": "prettier --write \"resources/**/*.{js,ts,vue,css,json}\" vite.config.ts eslint.config.mjs package.json .prettierrc.json",
        "format:check": "prettier --check \"resources/**/*.{js,ts,vue,css,json}\" vite.config.ts eslint.config.mjs package.json .prettierrc.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.5",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@vue/devtools-api": "^8.2.1",
        "axios": "^1.21.1",
        "pinia": "^4.1.0",
        "vue": "^3.5.46",
        "vue-i18n": "^11.4.23",
        "vue-router": "^5.5.1"
    }
}
